# Copy this file to .env and fill in your values
# cp .env.example .env   (Linux/Mac)
# copy .env.example .env (Windows)

# Classification mode: local | hybrid | api
# local  = keywords + embeddings only (no API calls)
# hybrid = local first, API only for ambiguous docs (recommended)
# api    = API-assisted for low-confidence cases (requires key below)
CLASSIFICATION_MODE=hybrid

# Reasoning provider for Tier 3 escalation: auto | local | openai | ollama | enterprise
# auto = enterprise if configured, else OpenAI if key set, else Ollama if running, else local only
REASONING_PROVIDER=auto

# Optional — required for hybrid/api OpenAI escalation; excerpts only, never full files
OPENAI_API_KEY=

# OpenAI model for low-confidence escalation (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Enterprise / private LLM — OpenAI-compatible API (Aleph Alpha, vLLM, Azure OpenAI, etc.)
# Required for REASONING_PROVIDER=enterprise or auto-selection when configured
ENTERPRISE_API_KEY=
ENTERPRISE_BASE_URL=
ENTERPRISE_MODEL=
ENTERPRISE_TIMEOUT=120
# Optional JSON object, e.g. {"X-Custom-Header": "value"}
ENTERPRISE_EXTRA_HEADERS=

# Ollama local LLM (used when REASONING_PROVIDER=ollama or auto with no cloud/enterprise key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
